[package]
name = "cratefield-testing"
description = "Conformance kit for Cratefield modules: fake ports, in-memory Database, request helpers"
readme = "README.md"
keywords = ["cratefield", "conformance", "testing", "fakes", "harness"]
categories = ["development-tools::testing"]
include = ["src/**/*", "README.md"]
version = "0.5.1"
edition.workspace = true
rust-version.workspace = true
license.workspace = true
repository.workspace = true

[lints]
workspace = true

[features]
default = ["harness"]

# The heavy graph: the module conformance suite (`conformance`), the
# `TestHarness` over the in-memory SQLite adapter, the `request` helper
# and the dialect axis. Everything here needs axum, tower, sea-query or
# `cratefield-adapter-sqlite` — a consumer that needs none of those
# should use `default-features = false` with `port-conformance`.
harness = [
    # The full kit includes the port helpers. `assert_wasm_safe_deps` is
    # called by ten module and auth conformance tests that take the
    # default feature, and `port` needs nothing beyond `cratefield-core`
    # — so gating it on `port-conformance` alone left those crates
    # without it. A workspace test run hid that, because the three push
    # adapters enable `port-conformance` and unification handed it to
    # everyone; CI's per-module matrix job, which builds a narrower
    # selection, did not.
    "port-conformance",
    "dep:async-trait",
    "dep:axum",
    "dep:cratefield-adapter-sqlite",
    "dep:futures-util",
    "dep:pollster",
    "dep:sea-query",
    "dep:serde",
    "dep:serde_json",
    "dep:time",
    "dep:tower",
    "dep:tracing",
]

# Port-only conformance helpers that need nothing beyond
# `cratefield-core` (issue #201): `push_recipient_conformance`,
# `vector_index_conformance` and `assert_wasm_safe_deps`. Pulls no
# database adapter, no axum, no tower — the feature an adapter depends on
# when its whole use of the kit is one free function over a port.
port-conformance = ["dep:serde_json"]

# The Postgres parity leg (issue #20): pulls the native-only Postgres
# adapter and a private tokio runtime that drives its sqlx pool. Opt-in
# so the default cratefield-testing dependency graph stays free of sqlx
# and tokio — a module's wasm build must never see them. Modules enable
# it on their cratefield-testing dev-dependency; the Postgres leg itself
# only runs when FZ_TEST_POSTGRES_URL names a server. Implies the heavy
# `harness` graph: the parity axis runs modules through the full suite.
postgres = ["harness", "dep:cratefield-adapter-postgres", "dep:tokio"]

[dependencies]
cratefield-core = { workspace = true }
# The webhook signers (issue #666) are ungated, so `http` and the HMAC
# stack are always present. All three are already in core's own tree —
# `http` and HMAC are core's webhook-verification deps — so making them
# unconditional adds no crate to a consumer's build.
http = { workspace = true }
hmac = { workspace = true }
sha2 = { workspace = true }
base64 = { workspace = true }
# The `Blob` large-object contract (issue #586) is ungated like the
# `Database` one, and it reads and writes `bytes::Bytes` through
# `cratefield_core::BoxStream`. Both crates are unconditional dependencies
# of `cratefield-core`, which this crate always depends on, so making them
# unconditional adds no crate to a consumer's build either.
bytes = { workspace = true }
futures-core = { workspace = true }
cratefield-adapter-sqlite = { workspace = true, optional = true }
cratefield-adapter-postgres = { workspace = true, optional = true }
tokio = { workspace = true, optional = true }
axum = { workspace = true, optional = true }
tower = { workspace = true, optional = true }
serde = { workspace = true, optional = true }
serde_json = { workspace = true, optional = true }
async-trait = { workspace = true, optional = true }
time = { workspace = true, optional = true }
# `MemoryActors` serializes one actor's calls with `futures_util::lock::Mutex`,
# and the actor contract fans 100 calls out with `futures_util::future::join_all`
# (issue #583). Pure Rust, wasm-safe, already in the workspace tree.
futures-util = { workspace = true, optional = true }
pollster = { workspace = true, optional = true }
sea-query = { workspace = true, optional = true }
tracing = { workspace = true, optional = true }
