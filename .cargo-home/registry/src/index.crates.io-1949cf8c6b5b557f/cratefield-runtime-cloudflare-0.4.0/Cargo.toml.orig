[package]
name = "cratefield-runtime-cloudflare"
description = "Cloudflare Workers runtime for the Cratefield harness (workers-rs)"
readme = "README.md"
keywords = ["cratefield", "cloudflare", "workers", "wasm", "serverless"]
categories = ["web-programming"]
include = ["src/**/*", "README.md"]
version = "0.4.0"
edition.workspace = true
rust-version.workspace = true
license.workspace = true
repository.workspace = true

[lints]
workspace = true

[features]
# `Cloudflare::push_from_env()` (issue #191): assemble the `Push` port from
# the venture's environment, and log which transports were configured once at
# cold start. Off by default because `cratefield-push-wiring` pulls all three
# push adapters and the crypto behind them, and a venture that sends no
# notifications must not carry them in its wasm.
push = ["dep:cratefield-push-wiring"]

[dependencies]
cratefield-core = { workspace = true }
# Verifies a caller's token against the issuer's key set (issue #153),
# assembled from the environment by `auth_from_env`.
cratefield-auth-client = { workspace = true }
cratefield-push-wiring = { workspace = true, optional = true }
worker = { workspace = true }
# Declares the Vectorize index binding; `worker` 0.8.5 re-exports the same version.
wasm-bindgen = { workspace = true }
axum = { workspace = true }
http = { workspace = true }
tower = { workspace = true }
bytes = { workspace = true }
futures-core = { workspace = true }
futures-util = { workspace = true }
async-trait = { workspace = true }
serde = { workspace = true }
serde_json = { workspace = true }
tracing = { workspace = true }
time = { workspace = true }
sha2 = { workspace = true }
sea-query = { workspace = true }


[target.'cfg(target_arch = "wasm32")'.dependencies]
getrandom = { workspace = true }

[dev-dependencies]
# Drives the native `#[cfg(test)]` tests of the pure body-gate helpers
# (`worker::Request` itself cannot be constructed outside wasm) and of the
# Vectorize adapter's seam, incl. the shared conformance suite.
pollster = { workspace = true }
# `port-conformance` alone: the light feature carrying
# `vector_index_conformance` (issue #561), as `cratefield-adapter-apns` takes.
cratefield-testing = { path = "../testing", default-features = false, features = [
    "port-conformance",
] }
