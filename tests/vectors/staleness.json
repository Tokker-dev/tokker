{
  "description": "Shared staleness vectors: the build (tools/freshness.mjs) and the Worker (crates/tokker-api/src/freshness.rs) must agree on every one. age is whole UTC days from the last_verified_at date to today; stale = age > sla_days, so age == SLA is fresh and a row verified today (or later) never is. stale_since is the first stale day: last_verified date + sla_days + 1.",
  "rules": "data/rules/freshness.json",
  "vectors": [
    { "name": "volatile age 0 (verified today): never stale", "row_type": "api_offer", "volatility": "high", "last_verified_at": "2026-10-05", "today": "2026-10-05", "expect": { "class": "volatile_api", "sla_days": 3, "stale": false, "stale_since": null } },
    { "name": "volatile at SLA-1: fresh", "row_type": "api_offer", "volatility": "high", "last_verified_at": "2026-10-03", "today": "2026-10-05", "expect": { "class": "volatile_api", "sla_days": 3, "stale": false, "stale_since": null } },
    { "name": "volatile at SLA: still fresh", "row_type": "api_offer", "volatility": "high", "last_verified_at": "2026-10-02", "today": "2026-10-05", "expect": { "class": "volatile_api", "sla_days": 3, "stale": false, "stale_since": null } },
    { "name": "volatile at SLA+1: stale since today", "row_type": "api_offer", "volatility": "high", "last_verified_at": "2026-10-01", "today": "2026-10-05", "expect": { "class": "volatile_api", "sla_days": 3, "stale": true, "stale_since": "2026-10-05" } },
    { "name": "standard age 0 (verified today): never stale", "row_type": "api_offer", "volatility": "medium", "last_verified_at": "2026-10-05", "today": "2026-10-05", "expect": { "class": "standard_api", "sla_days": 10, "stale": false, "stale_since": null } },
    { "name": "standard at SLA-1: fresh", "row_type": "api_offer", "volatility": "medium", "last_verified_at": "2026-09-26", "today": "2026-10-05", "expect": { "class": "standard_api", "sla_days": 10, "stale": false, "stale_since": null } },
    { "name": "standard at SLA: still fresh", "row_type": "api_offer", "volatility": "medium", "last_verified_at": "2026-09-25", "today": "2026-10-05", "expect": { "class": "standard_api", "sla_days": 10, "stale": false, "stale_since": null } },
    { "name": "standard at SLA+1 (medium, 11 days): stale", "row_type": "api_offer", "volatility": "medium", "last_verified_at": "2026-09-24", "today": "2026-10-05", "expect": { "class": "standard_api", "sla_days": 10, "stale": true, "stale_since": "2026-10-05" } },
    { "name": "subscription age 0 (verified today, volatility high): never stale", "row_type": "subscription", "volatility": "high", "last_verified_at": "2026-10-05", "today": "2026-10-05", "expect": { "class": "subscription", "sla_days": 14, "stale": false, "stale_since": null } },
    { "name": "subscription with volatility high at SLA-1: fresh, still 14 days", "row_type": "subscription", "volatility": "high", "last_verified_at": "2026-09-22", "today": "2026-10-05", "expect": { "class": "subscription", "sla_days": 14, "stale": false, "stale_since": null } },
    { "name": "subscription at SLA: still fresh", "row_type": "subscription", "volatility": "high", "last_verified_at": "2026-09-21", "today": "2026-10-05", "expect": { "class": "subscription", "sla_days": 14, "stale": false, "stale_since": null } },
    { "name": "subscription at SLA+1: stale", "row_type": "subscription", "volatility": "high", "last_verified_at": "2026-09-20", "today": "2026-10-05", "expect": { "class": "subscription", "sla_days": 14, "stale": true, "stale_since": "2026-10-05" } },
    { "name": "low volatility is standard_api and stale", "row_type": "api_offer", "volatility": "low", "last_verified_at": "2026-09-01", "today": "2026-10-05", "expect": { "class": "standard_api", "sla_days": 10, "stale": true, "stale_since": "2026-09-12" } },
    { "name": "date-time last_verified_at uses its date part (at SLA: fresh)", "row_type": "api_offer", "volatility": "high", "last_verified_at": "2026-10-02T14:30:00Z", "today": "2026-10-05", "expect": { "class": "volatile_api", "sla_days": 3, "stale": false, "stale_since": null } },
    { "name": "stale_since crosses the month and year boundary", "row_type": "api_offer", "volatility": "medium", "last_verified_at": "2025-12-20", "today": "2026-01-01", "expect": { "class": "standard_api", "sla_days": 10, "stale": true, "stale_since": "2025-12-31" } },
    { "name": "stale_since crosses a leap day", "row_type": "api_offer", "volatility": "high", "last_verified_at": "2024-02-27", "today": "2024-03-02", "expect": { "class": "volatile_api", "sla_days": 3, "stale": true, "stale_since": "2024-03-02" } },
    { "name": "verified in the future: never stale", "row_type": "api_offer", "volatility": "high", "last_verified_at": "2026-10-06", "today": "2026-10-05", "expect": { "class": "volatile_api", "sla_days": 3, "stale": false, "stale_since": null } }
  ]
}
